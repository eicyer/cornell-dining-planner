# Copy to frontend/.env (gitignored) for local overrides, or set in your
# EAS/build environment for real builds. Expo inlines EXPO_PUBLIC_* vars at
# build time automatically — no extra config needed.

# Backend base URL. Defaults to http://localhost:8001 if unset (see api.ts).
# On a physical device/simulator, localhost won't reach your Mac — use your
# LAN IP instead (`ipconfig getifaddr en0`), e.g. http://192.168.1.23:8001.
EXPO_PUBLIC_API_BASE=http://localhost:8001
