# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit it. See backend/app/core/config.py for how
# these are loaded (Settings) and docs/adr/0018 for the production
# fail-fast checks that run when ENVIRONMENT=production.

# development (default) | production
# Setting this to "production" activates fail-fast validation in
# backend/app/core/config.py and stricter session-cookie/security-header
# behavior — don't set it until the vars below marked [prod-required] are
# real production values.
ENVIRONMENT=development

# Anthropic Claude API — used server-side for nutrition enrichment and
# free-text preference parsing.
ANTHROPIC_API_KEY=

# USDA FoodData Central (free at https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY=

# Local Postgres (docker-compose, mapped to 5433 by default).
# [prod-required] must not contain the dev-default postgres:postgres@localhost
# credentials once ENVIRONMENT=production.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/cornell_dining

# Google OAuth (create at https://console.cloud.google.com/apis/credentials
# — OAuth client ID, type "Web application"). Authorized redirect URI for
# local dev: http://localhost:8001/auth/callback
# [prod-required] both must be set to real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session cookie signing (generate with: openssl rand -hex 32)
# [prod-required] must not be the "dev-only-change-me" default.
SESSION_SECRET=dev-only-change-me

# Where the OAuth callback redirects back to after login.
# [prod-required] must be an https:// URL.
FRONTEND_URL=http://localhost:8081

# Comma-separated list of origins the backend's CORS policy allows.
# Defaults (if unset) to the Expo web dev-server ports. Set explicitly for
# any non-localhost deployment.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000

# Comma-separated list of Host headers the backend will accept
# (TrustedHostMiddleware). Defaults to localhost for dev.
ALLOWED_HOSTS=localhost,127.0.0.1

# Session cookie SameSite policy: lax (default, assumes frontend+backend
# share a registrable domain, see docs/adr/0018) | none (only for a
# cross-site deploy, e.g. frontend and backend on different platform
# domains — requires ENVIRONMENT=production so the cookie is also Secure,
# or browsers will reject it).
SESSION_COOKIE_SAMESITE=lax

# Sole account allowed into /admin — see docs/adr/0016. Not a secret, but
# keep it accurate; it's the entire authorization boundary for /admin/*.
ADMIN_EMAIL=you@example.com

# Only set this when the backend sits behind a same-origin reverse proxy
# (e.g. a Vercel rewrite fronting frontend + API on one domain so the
# session cookie isn't cross-site). When set, it overrides
# request.url_for() for building the OAuth redirect_uri, since the proxy's
# outbound Host header to this backend isn't the public-facing domain
# Google needs to redirect back to. Must match an Authorized redirect URI
# registered on the Google OAuth client (as <this>/auth/callback).
OAUTH_REDIRECT_BASE_URL=
